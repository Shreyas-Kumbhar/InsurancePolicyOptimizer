<%- include("partials/header.ejs") %>

<main class="flex-grow-1 bg-light py-5">
    <div class="container py-3">
        <div class="row mb-4">
            <div class="col-12">
                <h1 class="display-5 fw-bolder font-headline text-dark mb-2">My Dashboard</h1>
                <p class="fs-5 text-secondary">Welcome back, <%= user.firstName %> <%= user.lastName %>!</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 text-center">
                        <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex p-3 mb-3">
                            <span class="material-symbols-outlined fs-1">account_circle</span>
                        </div>
                        <h4 class="fw-bold mb-1"><%= user.firstName %> <%= user.lastName %></h4>
                        <p class="text-secondary mb-4"><%= user.email %></p>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-bottom p-4">
                        <h4 class="mb-0 fw-bold font-headline d-flex align-items-center gap-2">
                            <span class="material-symbols-outlined text-primary">inventory_2</span>
                            My Allocated Policies
                        </h4>
                    </div>
                    <div class="card-body p-0">
                        <% if (user.allocatedPolicies && user.allocatedPolicies.length > 0) { %>
                            <div class="list-group list-group-flush rounded-bottom-4">
                                <% user.allocatedPolicies.forEach(policy => { %>
                                    <a href="/policies/<%= policy._id %>" class="list-group-item list-group-item-action p-4">
                                        <div class="d-flex w-100 justify-content-between align-items-center">
                                            <div>
                                                <h5 class="mb-1 fw-bold text-dark"><%= policy.name %></h5>
                                                <p class="mb-1 text-secondary"><%= policy.provider %> • <span class="text-capitalize"><%= policy.type %> Insurance</span></p>
                                                <div class="d-flex gap-3 mt-2">
                                                    <span class="badge bg-light text-dark border">
                                                        Premium: ₹<%= policy.premium.toLocaleString('en-IN') %>
                                                    </span>
                                                    <span class="badge bg-light text-dark border">
                                                        Coverage: ₹<%= policy.coverage.toLocaleString('en-IN') %>
                                                    </span>
                                                </div>
                                            </div>
                                            <span class="material-symbols-outlined text-muted">chevron_right</span>
                                        </div>
                                    </a>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="text-center p-5">
                                <span class="material-symbols-outlined text-secondary mb-3" style="font-size: 4rem; opacity: 0.5;">find_in_page</span>
                                <h5 class="text-secondary fw-semibold">No Policies Allocated Yet</h5>
                                <p class="text-muted mb-4">Run the optimization engine to find the best policies for your needs.</p>
                                <a href="/policies" class="btn btn-primary rounded-pill px-4 fw-bold">Find Policies</a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include("partials/footer.ejs") %>
