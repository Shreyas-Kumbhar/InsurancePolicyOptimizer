<%- include("../partials/header.ejs") %>

    <main class="flex-grow-1 bg-light py-5">
        <div class="container py-4">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="text-center mb-5">
                        <h1 class="display-5 fw-bolder font-headline text-dark mb-3">Policy Configuration</h1>
                        <p class="fs-5 text-secondary">Set your parameters to let the engine find the most optimized
                            coverage.</p>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-header bg-white border-bottom p-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary-subtle text-primary rounded-circle p-2 d-flex">
                                    <span class="material-symbols-outlined">tune</span>
                                </div>
                                <h4 class="mb-0 fw-bold font-headline">Optimization Parameters</h4>
                            </div>
                        </div>
                        <div class="card-body p-5">
                            <form action="/policies/results" method="GET">

                                <!-- Coverage Requirements -->
                                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                                    <span class="material-symbols-outlined text-secondary fs-5">health_and_safety</span>
                                    Coverage Required
                                </h5>
                                <div class="row g-4 mb-5">
                                    <div class="col-md-6">
                                        <label class="form-label text-secondary fw-semibold small">Minimum Coverage
                                            (₹)</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0">₹</span>
                                            <input type="number" class="form-control border-start-0 ps-0"
                                                name="coverage_min" placeholder="100000" value="100000">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-secondary fw-semibold small">Maximum Coverage
                                            (₹)</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0">₹</span>
                                            <input type="number" class="form-control border-start-0 ps-0"
                                                name="coverage_max" placeholder="2000000" value="2000000">
                                        </div>
                                    </div>
                                </div>

                                <hr class="text-muted mb-5">

                                <!-- Premium Constraint -->
                                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                                    <span
                                        class="material-symbols-outlined text-secondary fs-5">account_balance_wallet</span>
                                    Premium Constraint
                                </h5>
                                <div class="mb-5">
                                    <label class="form-label text-secondary fw-semibold small">Maximum Annual Premium
                                        (₹)</label>
                                    <div class="input-group mb-2">
                                        <span class="input-group-text bg-light border-end-0">₹</span>
                                        <input type="number" class="form-control border-start-0 ps-0" name="max_premium"
                                            placeholder="10000" value="10000">
                                    </div>
                                    <div class="form-text">The highest amount you are willing to pay per year.</div>
                                </div>

                                <hr class="text-muted mb-5">

                                <!-- Type and Risk Profile -->
                                <div class="row g-4 mb-5">
                                    <div class="col-md-6">
                                        <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                                            <span class="material-symbols-outlined text-secondary fs-5">category</span>
                                            Policy Type
                                        </h5>
                                        <select class="form-select form-select-lg" name="type" id="policyTypeSelect">
                                            <option value="All Types" selected>All Types</option>
                                            <option value="life">Life Insurance</option>
                                            <option value="health">Health Insurance</option>
                                            <option value="car">Car Insurance</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                                            <span class="material-symbols-outlined text-secondary fs-5">speed</span>
                                            Risk Level
                                        </h5>
                                        <input type="hidden" name="riskLevel" id="riskLevelHidden" value="All Levels">
                                        <input type="text"
                                            class="form-control form-control-lg bg-light text-secondary fw-semibold"
                                            id="riskLevelDisplay" value="Any Risk Level" readonly>
                                    </div>
                                </div>

                                <!-- Dynamic Risk Factors -->
                                <div id="riskFactorsContainer" style="display: none;"
                                    class="mb-5 p-4 bg-light rounded-4 border">
                                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2 text-primary">
                                        <span class="material-symbols-outlined fs-5">analytics</span>
                                        Factors Used to Calculate Risk
                                    </h5>

                                    <!-- Health Insurance Factors -->
                                    <div id="healthFactors" class="risk-factors-section" style="display: none;">
                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Age</label>
                                                <input type="number" class="form-control health-factor" id="healthAge"
                                                    value="30">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Medical History</label>
                                                <select class="form-select health-factor" id="healthHistory">
                                                    <option value="good">Good</option>
                                                    <option value="fair">Fair</option>
                                                    <option value="poor">Poor</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Smoking/Alcohol
                                                    Habits</label>
                                                <select class="form-select health-factor" id="healthSmoking">
                                                    <option value="no">No</option>
                                                    <option value="yes">Yes</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Weight/BMI</label>
                                                <input type="number" class="form-control health-factor" id="healthBMI"
                                                    value="22">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Existing Diseases</label>
                                                <select class="form-select health-factor" id="healthDiseases">
                                                    <option value="none">None</option>
                                                    <option value="minor">Minor</option>
                                                    <option value="major">Major (e.g., Diabetes)</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Family History</label>
                                                <select class="form-select health-factor" id="healthFamily">
                                                    <option value="clear">Clear</option>
                                                    <option value="some">Some Issues</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Lifestyle</label>
                                                <select class="form-select health-factor" id="healthLifestyle">
                                                    <option value="active">Active</option>
                                                    <option value="sedentary">Sedentary</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Vehicle Insurance Factors -->
                                    <div id="carFactors" class="risk-factors-section" style="display: none;">
                                        <div class="row g-3">
                                            <!-- <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Driver Age</label>
                                                <input type="number" class="form-control car-factor" id="carAge" value="30">
                                            </div> -->
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Driving History
                                                    (Years)</label>
                                                <input type="number" class="form-control car-factor" id="carHistory"
                                                    value="5">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Accident History</label>
                                                <select class="form-select car-factor" id="carAccidents">
                                                    <option value="0">0 Accidents</option>
                                                    <option value="1">1 Accident</option>
                                                    <option value="2">2+ Accidents</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Vehicle Type</label>
                                                <select class="form-select car-factor" id="carType">
                                                    <option value="scooter">Scooter/Commuter</option>
                                                    <option value="sedan">Sedan</option>
                                                    <option value="suv">SUV</option>
                                                    <option value="sports">Sports Bike/Car</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Vehicle Age (Years)</label>
                                                <input type="number" class="form-control car-factor" id="carVehicleAge"
                                                    value="3">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Area/City</label>
                                                <select class="form-select car-factor" id="carArea">
                                                    <option value="rural">Rural/Small Town</option>
                                                    <option value="suburban">Suburban</option>
                                                    <option value="urban">Urban/Metro</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Annual Mileage (km)</label>
                                                <input type="number" class="form-control car-factor" id="carMileage"
                                                    value="10000">
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Life Insurance Factors -->
                                    <div id="lifeFactors" class="risk-factors-section" style="display: none;">
                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Age</label>
                                                <input type="number" class="form-control life-factor" id="lifeAge"
                                                    value="30">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Health Condition</label>
                                                <select class="form-select life-factor" id="lifeHealth">
                                                    <option value="excellent">Excellent</option>
                                                    <option value="good">Good</option>
                                                    <option value="poor">Poor</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Occupation</label>
                                                <select class="form-select life-factor" id="lifeOccupation">
                                                    <option value="office">Office Employee</option>
                                                    <option value="manual">Manual Labor</option>
                                                    <option value="dangerous">Dangerous (Miner/Pilot)</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Dangerous Hobbies</label>
                                                <select class="form-select life-factor" id="lifeHobbies">
                                                    <option value="no">No</option>
                                                    <option value="yes">Yes</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold">Smoking Status</label>
                                                <select class="form-select life-factor" id="lifeSmoking">
                                                    <option value="no">No</option>
                                                    <option value="yes">Yes</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-3 text-end">
                                        <span class="badge bg-primary fs-6 p-2" id="autoRiskBadge">Calculated Risk:
                                            Low</span>
                                    </div>
                                </div>

                                <div class="d-grid gap-3 mt-4 flex-md-row d-md-flex">
                                    <% if (currentUser) { %>
                                        <button type="submit"
                                            class="btn btn-primary btn-lg rounded-3 fw-bold py-3 shadow w-100">
                                            <span class="d-flex align-items-center justify-content-center gap-2">
                                                <span class="material-symbols-outlined">network_node</span>
                                                Run Optimization Engine
                                            </span>
                                        </button>
                                        <% } else { %>
                                            <a href="/login"
                                                class="btn btn-primary btn-lg rounded-3 fw-bold py-3 shadow w-100 text-decoration-none">
                                                <span class="d-flex align-items-center justify-content-center gap-2">
                                                    <span class="material-symbols-outlined">lock</span>
                                                    Login to Run Engine
                                                </span>
                                            </a>
                                            <% } %>

                                                <a href="/policies/results?show_all=true"
                                                    class="btn btn-outline-primary btn-lg rounded-3 fw-bold py-3 shadow-sm w-100">
                                                    <span
                                                        class="d-flex align-items-center justify-content-center gap-2">
                                                        <span class="material-symbols-outlined">list_alt</span>
                                                        Show All Policies
                                                    </span>
                                                </a>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const policyTypeSelect = document.getElementById('policyTypeSelect');
            const riskLevelDisplay = document.getElementById('riskLevelDisplay');
            const riskFactorsContainer = document.getElementById('riskFactorsContainer');
            const autoRiskBadge = document.getElementById('autoRiskBadge');

            const sections = {
                'health': document.getElementById('healthFactors'),
                'car': document.getElementById('carFactors'),
                'life': document.getElementById('lifeFactors')
            };

            function calculateHealthRisk() {
                let score = 0;
                const age = parseInt(document.getElementById('healthAge').value) || 30;
                const history = document.getElementById('healthHistory').value;
                const smoking = document.getElementById('healthSmoking').value;
                const bmi = parseInt(document.getElementById('healthBMI').value) || 22;
                const diseases = document.getElementById('healthDiseases').value;

                if (age > 50) score += 2;
                else if (age > 40) score += 1;

                if (history === 'poor') score += 2;
                else if (history === 'fair') score += 1;

                if (smoking === 'yes') score += 3;

                if (bmi > 30) score += 2;
                else if (bmi > 25) score += 1;

                if (diseases === 'major') score += 3;
                else if (diseases === 'minor') score += 1;

                return score;
            }

            function calculateCarRisk() {
                let score = 0;
                const age = parseInt(document.getElementById('carAge').value) || 30;
                const accidents = parseInt(document.getElementById('carAccidents').value) || 0;
                const type = document.getElementById('carType').value;
                const history = parseInt(document.getElementById('carHistory').value) || 0;

                if (age < 25) score += 3;
                else if (age > 65) score += 1;

                if (accidents >= 2) score += 3;
                else if (accidents === 1) score += 1;

                if (type === 'sports') score += 2;

                if (history < 2) score += 2;

                return score;
            }

            function calculateLifeRisk() {
                let score = 0;
                const age = parseInt(document.getElementById('lifeAge').value) || 30;
                const health = document.getElementById('lifeHealth').value;
                const occupation = document.getElementById('lifeOccupation').value;
                const hobbies = document.getElementById('lifeHobbies').value;
                const smoking = document.getElementById('lifeSmoking').value;

                if (age > 60) score += 3;
                else if (age > 45) score += 1;

                if (health === 'poor') score += 3;
                else if (health === 'good') score += 1;

                if (occupation === 'dangerous') score += 3;
                else if (occupation === 'manual') score += 1;

                if (hobbies === 'yes') score += 2;
                if (smoking === 'yes') score += 3;

                return score;
            }

            function updateRisk() {
                const type = policyTypeSelect.value;
                let score = 0;

                if (type === 'health') score = calculateHealthRisk();
                else if (type === 'car') score = calculateCarRisk();
                else if (type === 'life') score = calculateLifeRisk();
                else return; // Don't calculate for "All Types"

                let riskLevel = 'low';
                if (score >= 5) riskLevel = 'high';
                else if (score >= 3) riskLevel = 'medium';

                const displayNames = {
                    'low': 'Low Risk',
                    'medium': 'Medium Risk',
                    'high': 'High Risk'
                };

                riskLevelDisplay.value = displayNames[riskLevel];
                document.getElementById('riskLevelHidden').value = riskLevel;
                autoRiskBadge.textContent = 'Calculated Risk: ' + riskLevel.charAt(0).toUpperCase() + riskLevel.slice(1);

                // Adjust badge color
                autoRiskBadge.className = 'badge fs-6 p-2 ' +
                    (riskLevel === 'high' ? 'bg-danger' :
                        riskLevel === 'medium' ? 'bg-warning text-dark' : 'bg-success');
            }

            policyTypeSelect.addEventListener('change', function () {
                const type = this.value;

                // Hide all sections
                Object.values(sections).forEach(sec => {
                    if (sec) sec.style.display = 'none';
                });

                if (sections[type]) {
                    riskFactorsContainer.style.display = 'block';
                    sections[type].style.display = 'block';
                    updateRisk();
                } else {
                    riskFactorsContainer.style.display = 'none';
                    riskLevelDisplay.value = 'Any Risk Level';
                    document.getElementById('riskLevelHidden').value = 'All Levels';
                }
            });

            // Add event listeners to all factor inputs
            document.querySelectorAll('.health-factor, .car-factor, .life-factor').forEach(input => {
                input.addEventListener('change', updateRisk);
                input.addEventListener('input', updateRisk);
            });
        });
    </script>

    <%- include("../partials/footer.ejs") %>