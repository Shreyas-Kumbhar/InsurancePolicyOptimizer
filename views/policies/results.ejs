<%- include("../partials/header.ejs") %>

    <main class="flex-grow-1 bg-light py-5">
        <div class="container py-4">

            <div class="d-flex justify-content-between align-items-center mb-5">
                <div>
                    <h1 class="display-6 fw-bold font-headline mb-2">
                        <%= (typeof combinationMode !=='undefined' && combinationMode) ? 'Optimal Policy Combination'
                            : 'Search Results' %>
                    </h1>
                    <p class="text-secondary mb-0">
                        <% if (typeof combinationMode !=='undefined' && combinationMode) { %>
                            This combination of <%= policies.length %> policies meets your criteria optimally.
                                <% } else { %>
                                    Found <%= policies.length %> policies matching your criteria.
                                        <% } %>
                    </p>
                </div>
                <a href="/policies" class="btn btn-outline-secondary d-flex align-items-center gap-2 rounded-3">
                    <span class="material-symbols-outlined fs-5">tune</span> Adjust Parameters
                </a>
            </div>

            <% if(typeof combinationMode !=='undefined' && combinationMode && policies.length> 0) { %>
                <div class="alert d-flex align-items-center mb-4 border-0 shadow-sm rounded-4 p-4" role="alert"
                    style="background-color: #d1e7dd; color: #0f5132;">
                    <span class="material-symbols-outlined display-5 me-3">task_alt</span>
                    <div>
                        <h4 class="alert-heading fw-bold mb-1">Optimal Portfolio Found!</h4>
                        <p class="mb-0">This combination provides <strong class="fs-5">₹<%=
                                    totalCoverage.toLocaleString() %></strong> in total coverage for a combined premium
                            of <strong class="fs-5">₹<%= totalPremium.toLocaleString() %> / yr</strong>.</p>
                    </div>
                </div>
                <% } %>

                    <% if(policies.length> 0) { %>
                        <div class="row g-4">
                            <% policies.forEach((policy, index)=> { %>
                                <div class="col-lg-4 col-md-6">
                                    <div
                                        class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                                        <% if(index===0) { %>
                                            <div class="position-absolute top-0 end-0 bg-success text-white px-3 py-1 fw-bold small rounded-start-pill mt-3 shadow-sm z-1"
                                                style="background-color: var(--secondary) !important;">Top Match</div>
                                            <% } %>

                                                <div class="card-body p-4">
                                                    <div class="d-flex align-items-center gap-3 mb-4">
                                                        <div
                                                            class="bg-primary-subtle rounded-3 p-3 text-primary d-flex align-items-center justify-content-center">
                                                            <span class="material-symbols-outlined fs-3">
                                                                <%= policy.type==='life' ? 'monitor_heart'
                                                                    : 'health_and_safety' %>
                                                            </span>
                                                        </div>
                                                        <div>
                                                            <span
                                                                class="badge bg-secondary-subtle text-secondary mb-1 border">
                                                                <%= policy.provider %>
                                                            </span>
                                                            <h5 class="fw-bold font-headline mb-0 text-truncate"
                                                                title="<%= policy.name %>">
                                                                <%= policy.name %>
                                                            </h5>
                                                        </div>
                                                    </div>

                                                    <div class="bg-light p-3 rounded-3 mb-4">
                                                        <div class="row text-center mb-2">
                                                            <div class="col-6 border-end">
                                                                <p class="small text-muted mb-1 text-uppercase fw-semibold"
                                                                    style="font-size: 0.70rem;">Annual Premium</p>
                                                                <p class="fs-5 fw-bold text-primary mb-0 font-headline">
                                                                    ₹<%= policy.premium %>
                                                                </p>
                                                            </div>
                                                            <div class="col-6">
                                                                <p class="small text-muted mb-1 text-uppercase fw-semibold"
                                                                    style="font-size: 0.70rem;">Coverage</p>
                                                                <p class="fs-5 fw-bold text-dark mb-0 font-headline">₹
                                                                    <%= policy.coverage %>
                                                                </p>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <ul class="list-unstyled mb-4">
                                                        <li
                                                            class="d-flex justify-content-between align-items-center mb-2">
                                                            <span
                                                                class="text-secondary small d-flex align-items-center gap-2"><span
                                                                    class="material-symbols-outlined fs-6 text-muted">policy</span>
                                                                Type</span>
                                                            <span class="fw-medium text-capitalize">
                                                                <%= policy.type %>
                                                            </span>
                                                        </li>
                                                        <li class="d-flex justify-content-between align-items-center">
                                                            <span
                                                                class="text-secondary small d-flex align-items-center gap-2"><span
                                                                    class="material-symbols-outlined fs-6 text-muted">speed</span>
                                                                Risk Profile</span>
                                                            <span
                                                                class="fw-medium text-capitalize <%= policy.riskLevel === 'high' ? 'text-danger' : policy.riskLevel === 'medium' ? 'text-warning' : 'text-success' %>">
                                                                <%= policy.riskLevel %> Risk
                                                            </span>
                                                        </li>
                                                    </ul>
                                                </div>
                                                <div class="card-footer bg-white border-top p-3 text-center">
                                                    <% if (currentUser) { %>
                                                        <a href="/policies/<%= policy._id %>"
                                                            class="btn btn-light w-100 fw-bold border text-primary">View
                                                            Details</a>
                                                        <% } else { %>
                                                            <button
                                                                class="btn btn-light w-100 fw-bold border text-muted"
                                                                disabled title="Please log in to view details">View
                                                                Details (Login Required)</button>
                                                            <% } %>
                                                </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                        <% } else { %>
                            <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                                <span
                                    class="material-symbols-outlined display-1 text-muted opacity-50 mb-3">search_off</span>
                                <h3 class="fw-bold font-headline">No policies found</h3>
                                <p class="text-secondary">Try adjusting your budget or risk constraints.</p>
                                <a href="/policies" class="btn btn-primary rounded-3 mt-2 px-4 shadow-sm">Modify
                                    Search</a>
                            </div>
                            <% } %>

        </div>
    </main>

    <%- include("../partials/footer.ejs") %>