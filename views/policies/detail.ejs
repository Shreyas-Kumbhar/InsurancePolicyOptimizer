<%- include("../partials/header.ejs") %>

<main class="flex-grow-1 bg-light py-5">
    <div class="container py-3">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/policies" class="text-decoration-none fw-medium text-secondary">Search</a></li>
                <li class="breadcrumb-item"><a href="javascript:history.back()" class="text-decoration-none fw-medium text-secondary">Results</a></li>
                <li class="breadcrumb-item active fw-bold" aria-current="page">Policy Details</li>
            </ol>
        </nav>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <!-- Policy Header Banner -->
                    <div class="bg-primary text-white p-5 position-relative overflow-hidden">
                        <!-- Decorative background -->
                        <div class="position-absolute end-0 top-0 h-100 opacity-25 translate-middle-y mt-5">
                            <span class="material-symbols-outlined" style="font-size: 15rem;"><%= policy.type === 'life' ? 'monitor_heart' : 'health_and_safety' %></span>
                        </div>
                        
                        <div class="position-relative z-1">
                            <div class="d-inline-block bg-white text-primary px-3 py-1 rounded-pill fw-bold small mb-3 border shadow-sm">
                                <%= policy.provider %>
                            </div>
                            <h1 class="display-6 fw-bold font-headline mb-2"><%= policy.name %></h1>
                            <p class="opacity-75 fs-5 mb-0 text-capitalize"><%= policy.type %> Insurance Plan</p>
                        </div>
                    </div>

                    <div class="card-body p-5">
                        <div class="row g-5">
                            <!-- Core Numbers -->
                            <div class="col-md-7">
                                <h4 class="fw-bold font-headline mb-4 pb-2 border-bottom d-flex align-items-center gap-2">
                                    <span class="material-symbols-outlined text-primary">data_usage</span>
                                    Core Financials
                                </h4>
                                
                                <div class="row g-4 mb-4">
                                    <div class="col-sm-6">
                                        <div class="bg-light p-4 rounded-3 h-100 border text-center">
                                            <span class="material-symbols-outlined text-muted fs-3 mb-2">account_balance_wallet</span>
                                            <p class="text-secondary text-uppercase fw-bold small mb-1" style="font-size: 0.75rem;">Annual Premium</p>
                                            <h3 class="fw-bolder font-headline text-primary mb-0">₹<%= policy.premium.toLocaleString('en-IN') %></h3>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="bg-light p-4 rounded-3 h-100 border text-center">
                                            <span class="material-symbols-outlined text-muted fs-3 mb-2">admin_panel_settings</span>
                                            <p class="text-secondary text-uppercase fw-bold small mb-1" style="font-size: 0.75rem;">Total Coverage</p>
                                            <h3 class="fw-bolder font-headline text-dark mb-0">₹<%= policy.coverage.toLocaleString('en-IN') %></h3>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="bg-primary-subtle p-4 rounded-3 d-flex justify-content-between align-items-center text-primary mt-4 border border-primary-subtle">
                                    <div>
                                        <p class="mb-0 fw-bold small text-uppercase">Premium to Cover Ratio</p>
                                        <h4 class="fw-bold mb-0">~<%= ((policy.premium / policy.coverage) * 100).toFixed(2) %>%</h4>
                                    </div>
                                    <span class="material-symbols-outlined fs-1 opacity-50">query_stats</span>
                                </div>
                            </div>
                            
                            <!-- Analysis Metrics -->
                            <div class="col-md-5">
                                <h4 class="fw-bold font-headline mb-4 pb-2 border-bottom d-flex align-items-center gap-2">
                                    <span class="material-symbols-outlined text-primary">analytics</span>
                                    Risk Analysis
                                </h4>
                                
                                <ul class="list-group list-group-flush mb-4">
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3 bg-transparent">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="material-symbols-outlined text-secondary">speed</span>
                                            <span class="fw-bold text-secondary">Assessed Risk</span>
                                        </div>
                                        <span class="badge <%= policy.riskLevel === 'high' ? 'bg-danger' : policy.riskLevel === 'medium' ? 'bg-warning text-dark' : 'bg-success' %> rounded-pill px-3 py-2 text-capitalize shadow-sm">
                                            <%= policy.riskLevel %> Level
                                        </span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3 bg-transparent">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="material-symbols-outlined text-secondary">verified</span>
                                            <span class="fw-bold text-secondary">Provider Reliability</span>
                                        </div>
                                        <span class="fw-bold text-success">Excellent</span>
                                    </li>
                                </ul>
                                
                                <div class="d-grid gap-3 mt-4">
                                    <% if (currentUser) { %>
                                        <form action="/policies/<%= policy._id %>/allocate" method="POST" class="d-grid">
                                            <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold py-3 shadow-sm d-flex justify-content-center align-items-center gap-2">
                                                <span class="material-symbols-outlined">add_task</span> Allocate Policy
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <a href="/login" class="btn btn-primary btn-lg rounded-3 fw-bold py-3 shadow-sm d-flex justify-content-center align-items-center gap-2 text-decoration-none">
                                            <span class="material-symbols-outlined">lock</span> Login to Allocate
                                        </a>
                                    <% } %>
                                    <button class="btn btn-outline-secondary btn-lg rounded-3 fw-bold py-3 d-flex justify-content-center align-items-center gap-2">
                                        <span class="material-symbols-outlined">file_download</span> Download PDF
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include("../partials/footer.ejs") %>
