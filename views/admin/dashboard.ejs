<%- include("../partials/header.ejs") %>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold font-headline mb-0">Admin Dashboard</h2>
            <p class="text-secondary mb-0">Manage Insurance Policies</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin/policies/new" class="btn btn-success fw-bold d-flex align-items-center gap-2">
                <span class="material-symbols-outlined">add</span> Add Policy
            </a>
            <a href="/admin/logout" class="btn btn-outline-danger fw-bold d-flex align-items-center gap-2">
                <span class="material-symbols-outlined">logout</span> Logout
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Policy Name</th>
                            <th>Provider</th>
                            <th>Type</th>
                            <th>Premium (₹)</th>
                            <th>Coverage (₹)</th>
                            <th>Risk Level</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (policies && policies.length > 0) { %>
                            <% policies.forEach(policy => { %>
                                <tr>
                                    <td class="ps-4 fw-semibold"><%= policy.name %></td>
                                    <td><%= policy.provider %></td>
                                    <td class="text-capitalize"><%= policy.type %></td>
                                    <td><%= policy.premium.toLocaleString('en-IN') %></td>
                                    <td><%= policy.coverage.toLocaleString('en-IN') %></td>
                                    <td>
                                        <span class="badge <%= policy.riskLevel === 'high' ? 'bg-danger' : policy.riskLevel === 'medium' ? 'bg-warning text-dark' : 'bg-success' %> text-capitalize">
                                            <%= policy.riskLevel %>
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="/admin/policies/<%= policy._id %>/edit" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center">
                                            <span class="material-symbols-outlined fs-6">edit</span>
                                        </a>
                                        <form action="/admin/policies/<%= policy._id %>?_method=DELETE" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center" onclick="return confirm('Are you sure you want to delete this policy?')">
                                                <span class="material-symbols-outlined fs-6">delete</span>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center py-5 text-secondary">
                                    <span class="material-symbols-outlined fs-1 mb-2">find_in_page</span>
                                    <p class="mb-0">No policies found. Create your first policy to get started.</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include("../partials/footer.ejs") %>