<%- include("../partials/header.ejs") %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold font-headline mb-0">Edit Policy</h2>
                <a href="/admin/dashboard" class="btn btn-outline-secondary fw-bold">Cancel</a>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form action="/admin/policies/<%= policy._id %>?_method=PUT" method="POST">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label for="name" class="form-label fw-semibold">Policy Name</label>
                                <input type="text" class="form-control form-control-lg rounded-3" id="name" name="policy[name]" value="<%= policy.name %>" required>
                            </div>
                            <div class="col-md-6">
                                <label for="provider" class="form-label fw-semibold">Provider</label>
                                <input type="text" class="form-control form-control-lg rounded-3" id="provider" name="policy[provider]" value="<%= policy.provider %>" required>
                            </div>
                            <div class="col-md-6">
                                <label for="type" class="form-label fw-semibold">Policy Type</label>
                                <select class="form-select form-select-lg rounded-3" id="type" name="policy[type]" required>
                                    <option value="life" <%= policy.type === 'life' ? 'selected' : '' %>>Life Insurance</option>
                                    <option value="health" <%= policy.type === 'health' ? 'selected' : '' %>>Health Insurance</option>
                                    <option value="vehicle" <%= policy.type === 'vehicle' ? 'selected' : '' %>>Vehicle Insurance</option>
                                    <option value="home" <%= policy.type === 'home' ? 'selected' : '' %>>Home Insurance</option>
                                    <option value="travel" <%= policy.type === 'travel' ? 'selected' : '' %>>Travel Insurance</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="riskLevel" class="form-label fw-semibold">Risk Level</label>
                                <select class="form-select form-select-lg rounded-3" id="riskLevel" name="policy[riskLevel]" required>
                                    <option value="low" <%= policy.riskLevel === 'low' ? 'selected' : '' %>>Low</option>
                                    <option value="medium" <%= policy.riskLevel === 'medium' ? 'selected' : '' %>>Medium</option>
                                    <option value="high" <%= policy.riskLevel === 'high' ? 'selected' : '' %>>High</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="premium" class="form-label fw-semibold">Premium (₹)</label>
                                <input type="number" class="form-control form-control-lg rounded-3" id="premium" name="policy[premium]" value="<%= policy.premium %>" min="0" required>
                            </div>
                            <div class="col-md-6">
                                <label for="coverage" class="form-label fw-semibold">Coverage (₹)</label>
                                <input type="number" class="form-control form-control-lg rounded-3" id="coverage" name="policy[coverage]" value="<%= policy.coverage %>" min="0" required>
                            </div>
                            <div class="col-12 mt-5">
                                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 fw-bold">Update Policy</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include("../partials/footer.ejs") %>
